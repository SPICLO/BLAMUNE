# ============================================================
# BLAMUNE - variables d'environnement (modele)
# Local : copie ce fichier en ".env". Production : dashboard Render.
# ".env" est ignore par git : ne committe JAMAIS de vraie cle.
# ============================================================

# ---------- Serveur ----------
# Port d'ecoute HTTP (Render le fournit automatiquement).
PORT=8080
# Mode d'execution. Ex. "production" en prod ; "test" pour desactiver le chargement de .env.
NODE_ENV=
# Repertoire des donnees (comptes.json, users/, savoir.txt...).
# Par defaut : la racine du projet. Utile pour les tests isoles.
# BLAMUNE_DATA_DIR=

# ---------- IA (optionnel : le bot repond 100% en local sans cle) ----------
# Fournisseur : "gemini" (defaut) ou un fournisseur compatible OpenAI :
# openai | groq | openrouter | ollama | lmstudio | vllm | mistral | deepseek
API_PROVIDER=gemini
# Cle API du fournisseur. Inutile pour Ollama en local.
API_KEY=
# Plusieurs cles Gemini (separees par des virgules) pour limiter les erreurs de quota.
# API_KEYS=cle1,cle2,cle3
API_KEYS=
# Modele principal.
API_MODEL=gemini-3.5-flash
# Modeles de secours (separes par des virgules), essayes si le principal echoue.
# API_MODELS=
# URL de base de l'API :
#   Gemini     : https://generativelanguage.googleapis.com/v1beta
#   Groq       : https://api.groq.com/openai/v1
#   OpenRouter : https://openrouter.ai/api/v1
#   Ollama     : http://127.0.0.1:11434/v1
API_URL=https://generativelanguage.googleapis.com/v1beta
# Reponses courtes : 1024 suffit largement.
API_MAX_TOKENS=1024
API_TEMPERATURE=0.7

# Extraction des faits par le modele (tache de fond). 0 pour la couper.
MEMOIRE_EXTRACTION=1
# Recherche web (grounding Google) : 0 pour la couper.
RECHERCHE_WEB=1
# Pause entre deux taches d'extraction de fond (ms).
EXTRACT_PAUSE_MS=

# ---------- Bot C++ local (service HTTP sur le cloud) ----------
# URL du service qui enveloppe bot.cpp. Vide = bot local desactive.
BOT_SERVICE_URL=
# Delai max d'attente de la reponse du bot local (ms).
BOT_SERVICE_TIMEOUT_MS=6000

# ---------- Limites anti-abus (requetes par minute) ----------
RATE_SEND_IP=30
RATE_SEND_UID=20

# ---------- Quota : attente max apres un "quota sature" (ms) ----------
QUOTA_ATTENTE_MAX_MS=70000
QUOTA_ATTENTE_MSG_MS=10000

# ---------- Admin ----------
# Pseudo qui a les droits admin (defaut : admin).
ADMIN_PSEUDO=admin
# Optionnel : fige l'uid exact du compte admin.
ADMIN_UID=

# ---------- Persistance cloud JSONBin (OBLIGATOIRE en production) ----------
# Sans JSONBIN_API_KEY, comptes/memoires/historiques sont perdus a chaque
# redeploiement Render (disque ephemere).
JSONBIN_API_KEY=
JSONBIN_BIN_ID=
JSONBIN_API_URL=https://api.jsonbin.io/v3/b
JSONBIN_SNAP_MIN_MS=
