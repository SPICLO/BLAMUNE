# ============================================================
# BLAMUNE - variables d'environnement (modele)
# Local : copie ce fichier en ".env". Production : dashboard Render.
# ".env" est ignore par git : ne committe JAMAIS de vraie cle.
# ============================================================

# ---------- Serveur ----------
# Port d'ecoute HTTP (Render le fournit automatiquement).
PORT=8080
# Mode d'execution. Ex. "production" en prod ; "test" pour desactiver le chargement de .env.
NODE_ENV=
# Repertoire des donnees (comptes.json, users/, savoir.txt...).
# Par defaut : la racine du projet. Utile pour les tests isoles.
# BLAMUNE_DATA_DIR=

# ---------- IA (optionnel : le bot repond 100% en local sans cle) ----------
# Fournisseur : "gemini" (defaut) ou un fournisseur compatible OpenAI :
# openai | groq | openrouter | ollama | lmstudio | vllm | mistral | deepseek
# | nvidia   (NIM, credits gratuits sur build.nvidia.com)
# | edenai  (passerelle payante multi-fournisseurs, ~1 100 modeles)
API_PROVIDER=gemini
# Cle API du fournisseur. Inutile pour Ollama en local.
# Cle Gemini gratuite : https://aistudio.google.com/app/apikey
API_KEY=
# Plusieurs cles (separees par des virgules) pour limiter les erreurs de quota.
# API_KEYS=cle1,cle2,cle3
API_KEYS=
# Modele principal.
API_MODEL=gemini-3.6-flash
# Modeles de secours (separes par des virgules), essayes si le principal echoue.
API_MODELS=gemini-3.5-flash-lite
# URL de base de l'API :
#   Gemini     : https://generativelanguage.googleapis.com/v1beta
#   OpenRouter : https://openrouter.ai/api/v1
#   Groq       : https://api.groq.com/openai/v1
#   Ollama     : http://127.0.0.1:11434/v1
#   NVIDIA NIM : https://integrate.api.nvidia.com/v1  (credits gratuits)
#   Eden AI    : https://api.edenai.run/v3   (PAYANT, credite le compte)
API_URL=https://generativelanguage.googleapis.com/v1beta
# Reponses courtes : 512 suffit largement en mode gratuit.
API_MAX_TOKENS=512
API_TEMPERATURE=0.7

# ---------- Pool multi-fournisseur (anti-saturation) ----------
# Cascade serveur : le fournisseur principal (API_PROVIDER/API_URL) est
# tente d'abord, puis chaque membre du pool, dans l'ordre. Un fournisseur
# qui renvoie 429/401/403/5xx repart en cooldown et le suivant prend le
# relais ; celui qui repond redevient prioritaire (sticky).
# Format : nom|url|cle|modele ; nom2|url2|cle2|modele2 (cle facultative,
# vide pour un service sans authentification, ex. Ollama ou un proxy local).
# Vide = pool desactive (cascade historique de modeles d'un seul
# fournisseur).
# Exemple :
#   API_POOL=groq|https://api.groq.com/openai/v1|gsk_...|llama-3.1-8b-instant
API_POOL=
# Duree de retrait d'un fournisseur apres un 429/5xx/erreur reseau (ms).
API_POOL_COOLDOWN_MS=60000
# Duree de retrait apres un 401/403 : seance morte, pas un pic de charge (ms).
API_POOL_COOLDOWN_AUTH_MS=600000

# ---------- Index semantique du savoir (Qdrant cloud, optionnel) ----------
# Memoire vectorielle des faits du savoir.db : retrouve une connaissance
# meme quand la question n'emploie pas ses mots exacts (recherche par
# cosinus). La vectorisation est LOCALE (hachage 256 d, sans reseau,
# gratuite) ; Qdrant ne fait que chercher. Sans QDRANT_URL/QDRANT_API_KEY
# OU avec QDRANT_ACTIV=0 : fonctionnalite eteinte, aucun changement
# visible. L'index se resynchronise entierement au demarrage.
# QDRANT_URL=https://TON-CLUSTER.cloud.qdrant.io
# QDRANT_API_KEY=ta_cle_qdrant
# QDRANT_COLLECTION=blamune-faits
# QDRANT_SEUIL=0.30
# QDRANT_ACTIV=1
# Impulseur de vecteurs. 'gemini' = vraie semantique via
# gemini-embedding-001 (gratuit, 768 d, quota d'EMBEDDING distinct du
# quota de chat des memes cles API_KEYS ; ~13 lots de 100 pour 1200
# faits au demarrage, quelques secondes de fond). Absent/vide = hachage
# local 256 d (sans reseau, plus grossier sur les synonymes).
# QDRANT_EMBED=gemini

# Extraction des faits par le modele (tache de fond). 0 pour la couper.
MEMOIRE_EXTRACTION=1
# Recherche web (grounding Google) : 0 pour la couper (economise les appels IA).
RECHERCHE_WEB=0
# Pause entre deux taches d'extraction de fond (ms).
EXTRACT_PAUSE_MS=

# ---------- Bot C++ local (service HTTP sur le cloud) ----------
# URL du service qui enveloppe bot.cpp. Vide = bot local desactive.
BOT_SERVICE_URL=
# Delai max d'attente de la reponse du bot local (ms).
BOT_SERVICE_TIMEOUT_MS=6000
# Dossier ou ecrire l'export savoir.txt partage avec le bot C++ du cloud.
# Vide = ecriture dans le dossier de donnees uniquement.
SAVOIR_EXPORT_DIR=

# ---------- Keep-alive ----------
# Rappel interne sur /health toutes les ~2 min 30, uniquement si personne
# n'est connecte, pour que Render ne mette pas l'instance en veille.
# 0 pour desactiver.
#
# A NE PAS DESACTIVER EN PRODUCTION : le rappel interne seul ne reveille pas
# une instance arretee. Le rappel externe est assure par le workflow
# .github/workflows/keepalive.yml (voir KEEPALIVE.md).
KEEPALIVE=1

# ---------- Limites anti-abus (requetes par minute) ----------
RATE_SEND_IP=30
RATE_SEND_UID=20

# ---------- Quota : attente max apres un "quota sature" (ms) ----------
QUOTA_ATTENTE_MAX_MS=70000
QUOTA_ATTENTE_MSG_MS=10000

# ---------- Admin ----------
# Pseudo qui a les droits admin (defaut : admin).
ADMIN_PSEUDO=admin
# Optionnel : fige l'uid exact du compte admin.
ADMIN_UID=
# Mot de passe du compte "admin" cree automatiquement au premier demarrage.
# 8 caracteres minimum.
#
# LAISSER VIDE EST SUR : un mot de passe aleatoire est alors genere et
# affiche UNE FOIS dans les journaux. C'est sur que ce depot est public --
# un mot de passe ecrit ici serait lisible par tout le monde et donnerait
# l'administration de toute instance deployee depuis ce depot.
# Renseignez cette variable pour choisir vous-meme le mot de passe.
#
# A changer sur une instance deja deployee : le mot de passe existant n est
# JAMAIS ecrase. Passez par /admin/change-mdp, ou supprimez comptes.json
# pour repartir d'un compte neuf.
ADMIN_MDP=

# ---------- Persistance cloud JSONBin (OBLIGATOIRE en production) ----------
# Sans JSONBIN_API_KEY, comptes/memoires/historiques sont perdus a chaque
# redeploiement Render (disque ephemere).
JSONBIN_API_KEY=
JSONBIN_BIN_ID=
JSONBIN_API_URL=https://api.jsonbin.io/v3/b
JSONBIN_SNAP_MIN_MS=
