# Editeur : regles communes a tous les contributeurs.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

# Scripts Windows : on garde les fins de ligne CRLF d'origine.
[*.{ps1,bat,cmd}]
end_of_line = crlf
